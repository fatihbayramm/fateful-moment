{
  "expo": {
    "name": "Fateful Moment",
    "slug": "fateful-moment",
    "version": "1.0.0",
    "orientation": "landscape",
    "scheme": "fatefulmoment",
    "icon": "./assets/images/app/app_icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fatihbayramybs.fatefulmoment",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "backgroundColor": "#020617",
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/images/app/app_icon_foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fatihbayramybs.fatefulmoment"
    },
    "web": {
      "favicon": "./assets/images/app/app_icon.png"
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": true
        }
      ],
      "./plugins/withForcedEdgeToEdge",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app/app_icon_splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
