{
  "expo": {
    "name": "fateful-moment",
    "slug": "fateful-moment",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fatihbayramybs.fatefulmoment"
    },
    "android": {
      "backgroundColor": "#020617",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "",
        "backgroundImage": "",
        "monochromeImage": ""
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fatihbayramybs.fatefulmoment"
    },
    "web": {
      "favicon": ""
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      "./plugins/withForcedEdgeToEdge"
    ]
  }
}
